# Copie para .env (que NÃO vai para o git) e preencha. As senhas do banco vão dentro de URLs: gere só com
# letras e números (openssl rand -hex 24). A SECRET_KEY pode ser qualquer texto longo (openssl rand -base64 36).

# Imagem da aplicação publicada pelo CI (ex.: ghcr.io/sua-org/ponto:v0.3.0). Fixe uma versão, não use :latest.
PONTO_IMAGE=

# Domínio público (o DNS já deve apontar para este servidor; HTTPS é automático)
DOMAIN=

# Senhas do banco. A do papel da aplicação: mínimo 16 caracteres entre letras, números, '-', '_' e '.'
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# Chave de assinatura dos tokens de login (mínimo 32 caracteres). Trocá-la desconecta todos os usuários.
SECRET_KEY=

# Fotos das batidas (opcional). PHOTO_STORE=local guarda na pasta do servidor; s3 usa um bucket S3-compatível PRIVADO.
# Confira depois de subir:  docker compose exec app python -m app.photos_check
PHOTO_STORE=local
S3_BUCKET=
S3_ENDPOINT_URL=      # vazio = AWS. R2: https://<conta>.r2.cloudflarestorage.com  B2: https://s3.<regiao>.backblazeb2.com
S3_REGION=            # AWS: sa-east-1 (São Paulo). R2: auto
S3_PREFIX=fotos/
S3_ACCESS_KEY_ID=     # vazio = papel IAM da máquina (AWS)
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256         # vazio se o provedor não suportar (as fotos já vão cifradas pela aplicação)
S3_PATH_STYLE=false   # true para MinIO

# Registro sem internet: prazo máximo (horas) entre a marcação e o envio; OFFLINE_PUNCH_ENABLED=false desliga o recurso.
OFFLINE_MAX_HOURS=72
OFFLINE_PUNCH_ENABLED=true

# Verificação em duas etapas (2FA). TOTP_KEY cifra os segredos de 2FA no banco: gere uma (openssl rand -base64 36),
# GUARDE-A com o mesmo cuidado do backup do banco e não a troque (trocar invalida o 2FA de todos, que precisam
# configurar de novo). Vazia = usa a SECRET_KEY, o que amarra os dois. REQUIRE_2FA_ROLES: perfis obrigados a usar
# 2FA, separados por vírgula (ex.: hr,admin). Recomendado para RH e administrador.
TOTP_KEY=
REQUIRE_2FA_ROLES=

# Conformidade REP-P (Portaria MTP 671/2021). Sem INPI e desenvolvedor a aplicação recusa gerar AFD/AEJ.
INPI_NUMBER=
DEV_ID=
DEV_NAME=
DEV_EMAIL=
CLOCK_CHECK_ENABLED=true
# Certificado ICP-Brasil (PKCS#12): coloque o arquivo em ./secrets e aponte o caminho dentro do contêiner.
SIGNING_P12_PATH=
SIGNING_P12_PASSWORD=

# Backups do banco: a cada N horas, mantendo os M mais recentes (336 = 14 dias de backups horários)
BACKUP_INTERVAL_HOURS=1
BACKUP_KEEP=336

# Processos da aplicação. Cada processo registra os eventos 07/08 do REP-P ao iniciar/parar; 1 é suficiente no início.
WEB_CONCURRENCY=1
